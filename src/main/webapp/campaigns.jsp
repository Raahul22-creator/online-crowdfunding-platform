<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.List,com.crowdfund.model.Campaign" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Campaigns</title><link rel="stylesheet" href="css/style.css"></head>
<body><header class="nav"><a class="brand" href="index.jsp">FundForward</a><nav><a href="create-campaign.jsp">Start a campaign</a><a href="index.jsp">Home</a></nav></header><main class="section"><span class="eyebrow">COMMUNITY IDEAS</span><h1>Explore campaigns</h1><div class="campaigns">
<% List<Campaign> campaigns=(List<Campaign>)request.getAttribute("campaigns"); if(campaigns==null||campaigns.isEmpty()){ %><article class="feature"><h3>No approved campaigns yet</h3><p>Submit a campaign or approve a test record in the database.</p></article><% } else { for(Campaign c:campaigns){ double pct=c.getTargetAmount().signum()==0?0:Math.min(100,c.getRaisedAmount().doubleValue()/c.getTargetAmount().doubleValue()*100); %>
<article class="campaign-card"><span class="pill">APPROVED</span><h3><%= c.getTitle() %></h3><p><%= c.getDescription() %></p><div class="progress"><span style="width:<%=pct%>%"></span></div><p>₹<%=c.getRaisedAmount()%> raised of ₹<%=c.getTargetAmount()%></p><form class="contribute" method="post" action="contribute"><input type="hidden" name="campaignId" value="<%=c.getId()%>"><input name="amount" type="number" min="1" step="0.01" placeholder="Amount in INR" required><button class="button primary" type="submit">Contribute</button></form></article>
<% }} %></div></main><footer>FundForward · Review 1</footer></body></html>
