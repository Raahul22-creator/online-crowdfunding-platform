<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create Campaign</title><link rel="stylesheet" href="css/style.css"></head>
<body><header class="nav"><a class="brand" href="index.jsp">FundForward</a><nav><a href="campaigns">Explore campaigns</a><a href="index.jsp">Home</a></nav></header><main class="form-wrap"><span class="eyebrow">SHARE YOUR IDEA</span><h1>Start a campaign</h1><p>New campaigns are saved as pending for review.</p>
<form class="form-card" method="post" action="create-campaign"><label>Campaign title<input name="title" maxlength="120" required></label><label>Your name<input name="creatorName" maxlength="80" required></label><label>Target amount (INR)<input name="targetAmount" type="number" min="1" step="0.01" required></label><label>Description<textarea name="description" rows="5" required></textarea></label><button class="button primary" type="submit">Submit campaign</button></form></main><footer>FundForward · Review 1</footer></body></html>
